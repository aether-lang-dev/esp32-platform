import contrib.tinyweb
import datastar
import std.file
import std.json
import std.list
import std.os
import std.string

fn controller_port() -> int {
    raw = os.getenv("REXX_CONTROLLER_PORT")
    if raw == "" { return 8787 }
    port, err = string.to_int(raw)
    if err != "" || port < 1 || port > 65535 { return 0 }
    return port
}

fn controller_origin() -> string {
    port = controller_port()
    return "127.0.0.1:${port}"
}

fn local_request(req: ptr, res: ptr) -> bool {
    host = tinyweb.request_get_header(req, "Host")
    if host != controller_origin() {
        tinyweb.response_write_status(res, "Unknown controller host", 403)
        return false
    }
    tinyweb.response_set_header(res, "Cache-Control", "no-store")
    tinyweb.response_set_header(res, "X-Content-Type-Options", "nosniff")
    tinyweb.response_set_header(res, "X-Frame-Options", "DENY")
    tinyweb.response_set_header(res, "Referrer-Policy", "no-referrer")
    return true
}

fn device_call(device: string, credential: string, action: string,
               session: string, sequence: int, source: string) -> string {
    args = list.new()
    defer list.free(args)
    list.add(args, "controller/device.py")
    list.add(args, "--device")
    list.add(args, device)
    list.add(args, "--credential")
    list.add(args, credential)
    list.add(args, action)
    list.add(args, "--session=${session}")
    list.add(args, "--sequence=${sequence}")
    list.add(args, "--source=${source}")
    python = os.getenv("REXX_CONTROLLER_PYTHON")
    if python == "" { python = "python3.13" }
    output, _code, err = os.run_capture(python, args, null)
    if err != "" || output == "" {
        return "{\"connected\":false,\"ok\":false,\"message\":\"Local transport failed\"}"
    }
    return output
}

fn text_field(value: ptr, name: string) -> string {
    field, _err = json.object_get(value, name)
    if field == null { return "" }
    text, err = json.get_string(field)
    if err != "" { return "" }
    return text
}

fn int_field(value: ptr, name: string) -> int {
    field, _err = json.object_get(value, name)
    return json.json_get_int(field)
}

fn bool_field(value: ptr, name: string) -> bool {
    field, _err = json.object_get(value, name)
    return json.json_get_bool(field) != 0
}

fn repl_patch(sse: ptr, sid: string, sequence: int, busy: bool,
              notice: string, transcript: string) -> string {
    signals = json.obj()
    defer json.json_free(signals)
    _a = json.set(signals, "sid", json.str(sid))
    _b = json.set(signals, "seq", json.from_int(sequence))
    flag = 0
    if busy { flag = 1 }
    _c = json.set(signals, "busy", json.boolean(flag))
    _d = json.set(signals, "message", json.str(notice))
    visible = transcript
    if string.length(visible) > 32000 {
        visible = string.concat("[earlier output trimmed]\n", string.substring(visible, string.length(visible) - 30000, string.length(visible)))
    }
    _e = json.set(signals, "transcript", json.str(visible))
    raw, _err = json.encode(signals)
    return datastar.patch_signals(sse, raw, null)
}

fn repl_action(req: ptr, res: ptr, device: string, credential: string, action: string) {
    if !local_request(req, res) { return }
    if tinyweb.request_get_header(req, "Origin") != "http://${controller_origin()}" {
        tinyweb.response_write_status(res, "Controller origin required", 403)
        return
    }
    signals, err = datastar.read_signals(req)
    if err != "" || signals == null {
        tinyweb.response_write_status(res, "Invalid signals", 400)
        return
    }
    defer json.json_free(signals)
    sid = text_field(signals, "sid")
    sequence = int_field(signals, "seq")
    source = text_field(signals, "code")
    transcript = text_field(signals, "transcript")
    submitted = source
    if action == "run" {
        if bool_field(signals, "showrc") { submitted = string.concat(submitted, "\nSAY 'RC =' RC") }
        if bool_field(signals, "showresult") { submitted = string.concat(submitted, "\nSAY 'RESULT =' RESULT") }
    }
    next = sequence
    if action == "run" { next = sequence + 1 }
    raw = device_call(device, credential, action, sid, next, submitted)
    result, parse_error = json.parse(raw)
    if parse_error != "" { tinyweb.response_write_status(res, "Invalid transport result", 502); return }
    defer json.json_free(result)
    sse, stream_error = datastar.new_sse(res)
    if stream_error != "" { return }
    defer datastar.sse_close(sse)
    if !bool_field(result, "ok") {
        notice = text_field(result, "error")
        if notice == "" { notice = text_field(result, "message") }
        if notice == "session expired or replaced" { sid = ""; sequence = 0 }
        _failed = repl_patch(sse, sid, sequence, false, notice, transcript)
        return
    }
    if action == "open" {
        sid = text_field(result, "session")
        _opened = repl_patch(sse, sid, 0, false, "REPL connected. Timers, ADDRESS APPS, SWITCH and OUTLET available.", transcript)
        return
    }
    if action == "close" {
        _closed = repl_patch(sse, "", 0, false, "Session closed", transcript)
        return
    }
    if action == "cancel" {
        _cancelled = datastar.patch_signals(sse, "{}", null)
        return
    }
    transcript = string.concat(transcript, string.concat("rexx> ", string.concat(source, "\n")))
    sent = repl_patch(sse, sid, next, true, "Running", transcript)
    cursor = 0
    for (poll = 0; poll < 40; poll++) {
        if sent != "" {
            _cancel = device_call(device, credential, "cancel", sid, 0, "")
            return
        }
        event_raw = device_call(device, credential, "events", sid, cursor, "")
        state, state_error = json.parse(event_raw)
        if state_error != "" { break }
        if !bool_field(state, "ok") {
            json.json_free(state)
            break
        }
        cursor = int_field(state, "cursor")
        if bool_field(state, "lost") { transcript = string.concat(transcript, "[device output buffer overrun]\n") }
        if int_field(state, "sequence") == next {
            transcript = string.concat(transcript, text_field(state, "output"))
            if text_field(state, "state") == "done" {
                rc = int_field(state, "exitCode")
                json.json_free(state)
                _done = repl_patch(sse, sid, next, false, "Exit ${rc}", transcript)
                return
            }
        }
        json.json_free(state)
        sent = repl_patch(sse, sid, next, true, "Running", transcript)
        sleep(150)
    }
    _unknown = repl_patch(sse, sid, next, false, "Outcome unknown. Close this session before retrying.", transcript)
}

main() {
    if os.args_count() != 3 {
        println("Usage: controller/run.sh https://device-address /absolute/device.json")
        return 1
    }
    device = os.args_get(1)
    credential = os.args_get(2)
    page, perr = file.read("controller/index.html")
    script, jerr = file.read("controller/assets/datastar.js")
    if perr != "" || jerr != "" {
        println("Run the controller from the ESP32 repository root")
        return 1
    }
    port = controller_port()
    if port == 0 { println("Invalid REXX_CONTROLLER_PORT"); return 1 }
    server = tinyweb.web_server_host("127.0.0.1", port) {
        tinyweb.end_point(tinyweb.GET, "/") |req: ptr, res: ptr, ctx: ptr| {
            if !local_request(req, res) { return }
            tinyweb.response_set_header(res, "Content-Type", "text/html; charset=utf-8")
            tinyweb.response_write(res, page)
        }
        tinyweb.end_point(tinyweb.GET, "/assets/datastar.js") |req: ptr, res: ptr, ctx: ptr| {
            if !local_request(req, res) { return }
            tinyweb.response_set_header(res, "Content-Type", "text/javascript; charset=utf-8")
            tinyweb.response_write(res, script)
        }
        tinyweb.end_point(tinyweb.POST, "/repl/open") |req: ptr, res: ptr, ctx: ptr| {
            repl_action(req, res, device, credential, "open")
        }
        tinyweb.end_point(tinyweb.POST, "/repl/run") |req: ptr, res: ptr, ctx: ptr| {
            repl_action(req, res, device, credential, "run")
        }
        tinyweb.end_point(tinyweb.POST, "/repl/cancel") |req: ptr, res: ptr, ctx: ptr| {
            repl_action(req, res, device, credential, "cancel")
        }
        tinyweb.end_point(tinyweb.POST, "/repl/close") |req: ptr, res: ptr, ctx: ptr| {
            repl_action(req, res, device, credential, "close")
        }
        tinyweb.end_point(tinyweb.GET, "/status") |req: ptr, res: ptr, ctx: ptr| {
            if !local_request(req, res) { return }
            raw = device_call(device, credential, "status", "", 0, "")
            signals, err = json.parse(raw)
            if err != "" { return }
            defer json.json_free(signals)
            sse, serr = datastar.new_sse(res)
            if serr != "" { return }
            defer datastar.sse_close(sse)
            _sent = datastar.patch_signals(sse, raw, null)
        }
    }
    println("Device controller at http://${controller_origin()}")
    err = tinyweb.tw_start(server)
    if err != "" { println(err); return 1 }
    tinyweb.tw_stop(server)
    return 0
}
