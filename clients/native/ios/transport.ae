// C ABI boundary: buffers belong to the trusted native adapter.
import tlsimpl
import std.bytes
exports(controller_tls_status, controller_tls_request)

controller_tls_status(host: string, port: int, identity: ptr, identity_len: int,
                      key: ptr, key_len: int, output: ptr, output_len: int,
                      error: ptr, error_len: int) -> int {
    if identity == null || key == null || output == null || error == null ||
       identity_len < 1 || identity_len > 64 || key_len != 32 ||
       output_len < 1 || output_len > 16384 || error_len < 1 || error_len > 256 { return -1 }
    return tlsimpl.request(host, port, (identity as byte[])[0..identity_len],
        (key as byte[])[0..key_len], (output as byte[])[0..output_len],
        (error as byte[])[0..error_len])
}

controller_tls_request(host: string, port: int, identity: ptr, identity_len: int,
                      key: ptr, key_len: int, request: ptr, request_len: int,
                      output: ptr, output_len: int, error: ptr, error_len: int) -> int {
    if identity == null || key == null || request == null || output == null || error == null ||
       identity_len < 1 || identity_len > 64 || key_len != 32 || request_len < 1 || request_len > 9216 ||
       output_len < 1 || output_len > 16384 || error_len < 1 || error_len > 256 { return -1 }
    return tlsimpl.request_http(host, port, (identity as byte[])[0..identity_len],
        (key as byte[])[0..key_len], bytes.string_from_ptr(request, request_len),
        (output as byte[])[0..output_len], (error as byte[])[0..error_len])
}
