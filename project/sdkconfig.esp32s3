# ESP32-S3-N16R8 (Guition JC3248W535C): 16 MB quad flash, 8 MB octal PSRAM.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# Octal PSRAM, added to the heap: malloc() takes internal DRAM for blocks up
# to CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL bytes and PSRAM beyond that (or when
# internal runs out).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y
