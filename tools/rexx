#!/usr/bin/env python3
"""Deliver signed Rexx revisions to a runner or fleet."""
import argparse
import http.client
import json
import os
import re
import socket
import subprocess
import time
from pathlib import Path
from urllib.parse import urlsplit

from rexx_bundle import GRANTS, IDENTIFIER, fingerprint, pack
from rexx_psk import client_context, load as load_psk


class DeliveryError(ValueError):
    pass


class Runner:
    def __init__(self, endpoint, credential=None):
        url = urlsplit(endpoint)
        if (url.scheme not in ("http", "https") or not url.hostname
                or url.username is not None or url.path not in ("", "/")
                or url.query or url.fragment):
            raise ValueError("device must be an HTTP(S) origin such as http://127.0.0.1:18080")
        self.connection = http.client.HTTPSConnection if url.scheme == "https" else http.client.HTTPConnection
        self.host, self.port = url.hostname, url.port
        self.tls_options = {}
        if credential is not None:
            if url.scheme != "https":
                raise ValueError("a device credential requires an https:// origin")
            self.tls_options["context"] = client_context(*load_psk(credential))

    def request(self, path, body=None):
        connection = self.connection(self.host, self.port, timeout=3, **self.tls_options)
        try:
            headers = {"Content-Type": "application/octet-stream"} if body is not None else {}
            connection.request("GET" if body is None else "POST", path, body, headers)
            response = connection.getresponse()
            raw = response.read(4097)
            if len(raw) > 4096:
                raise DeliveryError("runner response exceeds 4096 bytes")
            payload = json.loads(raw)
            if not isinstance(payload, dict):
                raise DeliveryError("runner returned an invalid JSON object")
            return response.status, payload
        finally:
            connection.close()

    def status(self):
        code, result = self.request("/status")
        if code != 200:
            raise DeliveryError(f"status returned HTTP {code}")
        for key in ("id", "activeVersion", "highestVersion", "trialVersion"):
            value = result.get(key)
            if type(value) is not int or not 0 <= value <= 0xffffffff:
                raise DeliveryError("device did not return signed runner status")
        if result.get("storeFault") is not False:
            raise DeliveryError("runner reports a storage fault or invalid status")
        if result.get("state") not in ("idle", "pending", "running", "done", "error"):
            raise DeliveryError("runner returned an unknown state")
        return result


def deliver(runner, source, args, desired=None, label=""):
    def report(message):
        print(f"{label}{message}", flush=True)
    deadline = time.monotonic() + 15
    before = runner.status()
    while before["state"] in ("pending", "running"):
        if time.monotonic() >= deadline:
            raise DeliveryError("runner stayed busy")
        time.sleep(0.1)
        before = runner.status()
    if desired is not None:
        active = before.get("activeFingerprint")
        if not isinstance(active, str) or (active and not re.fullmatch(r"[0-9a-f]{64}", active)):
            raise DeliveryError("device did not return an active fingerprint")
        if active == desired and before["activeVersion"] > 0:
            report(f"up to date (active v{before['activeVersion']})")
            return True
    version = before["highestVersion"] + 1
    blob = pack(source, name=args.name, version=version, key_id=args.key_id,
                grants=args.grant, private_key=args.private_key)
    try:
        code, receipt = runner.request("/script", blob)
    except (OSError, ValueError, http.client.HTTPException) as error:
        raise DeliveryError(f"v{version} upload outcome unknown ({error})") from error
    if code != 202:
        raise DeliveryError(f"v{version} upload refused (HTTP {code})")
    request_id = receipt.get("id")
    if type(request_id) is not int or not 1 <= request_id <= 0xffffffff:
        raise DeliveryError(f"v{version} upload outcome unknown (invalid receipt)")
    report(f"v{version} queued (request {request_id})")
    deadline = time.monotonic() + 15
    try:
        while time.monotonic() < deadline:
            result = runner.status()
            if result["id"] != request_id:
                raise DeliveryError("request changed or device restarted")
            if result["state"] in ("done", "error") and result["trialVersion"] == 0:
                active = result["activeVersion"]
                if (result["state"] == "done" and active == version
                        and result["highestVersion"] == version
                        and result.get("exitCode") == 0 and result.get("runtimeOutcome") == 0
                        and (desired is None or result.get("activeFingerprint") == desired)):
                    report(f"v{version} activated")
                    return True
                if result["state"] == "error" and result["highestVersion"] == version and active < version:
                    previous = f"active v{active}" if active else "no active release"
                    report(f"v{version} rolled back ({previous}, exit {result.get('exitCode')}, "
                           f"runtime outcome {result.get('runtimeOutcome')})")
                    return False
                raise DeliveryError("runner did not confirm activation or rollback")
            time.sleep(0.1)
        raise DeliveryError("status wait timed out")
    except (OSError, ValueError, http.client.HTTPException) as error:
        raise DeliveryError(f"v{version} trial outcome unknown ({error})") from error


def unique_object(pairs):
    result = {}
    for name, value in pairs:
        if name in result:
            raise ValueError("fleet contains a duplicate field")
        result[name] = value
    return result


def sync_fleet(args):
    raw = json.loads(args.fleet.read_text(), object_pairs_hook=unique_object)
    if not isinstance(raw, dict) or not raw:
        raise ValueError("fleet must be a nonempty object keyed by device name")
    devices = []
    for name, entry in raw.items():
        if (not IDENTIFIER.fullmatch(name) or not isinstance(entry, dict)
                or set(entry) != {"device", "credential"}
                or any(not isinstance(value, str) or not value for value in entry.values())):
            raise ValueError("each fleet member needs a device origin and credential path")
        devices.append((name, entry["device"], args.fleet.parent / entry["credential"]))
    protected = [args.fleet, args.private_key, *(credential for _, _, credential in devices)]
    with args.source.open("rb") as file:
        source_stat = os.fstat(file.fileno())
        for path in protected:
            try:
                matches = os.path.samestat(source_stat, path.stat())
            except FileNotFoundError:
                # An absent device credential is a failure for that device.
                continue
            if matches:
                raise ValueError("source must be separate from fleet and credential files")
        source = file.read(8193)
    desired = fingerprint(source, name=args.name, key_id=args.key_id, grants=args.grant)
    ok = True
    for name, endpoint, credential in devices:
        try:
            runner = Runner(endpoint, credential)
            ok &= deliver(runner, source, args, desired=desired, label=f"{name}: ")
        except (ConnectionError, TimeoutError, socket.gaierror) as error:
            print(f"{name}: unreachable ({error})", flush=True)
            ok = False
        except (OSError, ValueError, http.client.HTTPException, subprocess.CalledProcessError) as error:
            print(f"{name}: {error}", flush=True)
            ok = False
    return 0 if ok else 1


def signing_options(command):
    command.add_argument("source", type=Path)
    command.add_argument("--private-key", type=Path, required=True)
    command.add_argument("--key-id", required=True)
    command.add_argument("--name", required=True)
    command.add_argument("--grant", action="append", choices=sorted(GRANTS), default=[])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    watch = commands.add_parser("watch", help="sign and deliver changes")
    signing_options(watch)
    watch.add_argument("--device", required=True)
    watch.add_argument("--device-credential", type=Path, help="TLS PSK device credential JSON")
    watch.add_argument("--once", action="store_true", help="submit the file once and exit")
    sync = commands.add_parser("sync", help="reconcile a fleet with a signed script")
    signing_options(sync)
    sync.add_argument("--fleet", type=Path, required=True)
    args = parser.parse_args()
    if args.command == "sync":
        try:
            return sync_fleet(args)
        except (OSError, ValueError) as error:
            parser.exit(1, f"sync: {error}\n")
    try:
        runner = Runner(args.device, args.device_credential)
        protected = [args.private_key]
        if args.device_credential:
            protected.append(args.device_credential)
        if args.source.resolve() in {path.resolve() for path in protected}:
            raise ValueError("source must be separate from credential files")
    except (OSError, ValueError) as error:
        parser.error(str(error))

    sent = candidate = None
    read_error = None
    try:
        while True:
            try:
                with args.source.open("rb") as file:
                    source_stat = os.fstat(file.fileno())
                    if any(os.path.samestat(source_stat, path.stat()) for path in protected):
                        raise ValueError("source must be separate from credential files")
                    source = file.read(8193)
            except (OSError, ValueError) as error:
                if read_error != str(error):
                    print(f"watch: {error}", flush=True)
                if args.once:
                    return 1
                read_error = str(error)
                candidate = None
            else:
                read_error = None
                if args.once or (source == candidate and source != sent):
                    # Record the attempt before POST. A lost reply cannot cause
                    # an automatic replay of this edit at a different version.
                    sent = source
                    try:
                        ok = deliver(runner, source, args)
                    except (OSError, ValueError, http.client.HTTPException, subprocess.CalledProcessError) as error:
                        print(f"watch: {error}", flush=True)
                        ok = False
                    if args.once:
                        return 0 if ok else 1
                candidate = source
            time.sleep(0.25)
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
