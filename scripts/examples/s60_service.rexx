/* ADDRESS SERVICE main v1 */
IF ADDRESS_COMMAND = 'ADDRESS_COMMAND' THEN DO
  SAY 'S60 bench service ready'
  EXIT 0
END
PARSE VAR ADDRESS_COMMAND verb argument
SELECT
  WHEN TRANSLATE(verb) = 'STATUS' THEN SAY 'S60 bench ready'
  WHEN TRANSLATE(verb) = 'ECHO' THEN SAY argument
  OTHERWISE EXIT 4
END
EXIT 0
